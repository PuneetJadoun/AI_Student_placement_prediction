# MySQL connection (URL-encode special characters in the password)
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/student_ai_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSV_PATH=data/StudentsPerformance.csv

# Authentication: set a long random secret before using beyond local demo
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# First administrator is created automatically if these are configured
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
